{
  "name": "athenai-quant-agentic",
  "private": true,
  "version": "4.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vitest run && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "v2:dev": "vite --config v2/vite.config.ts",
    "v2:build": "vite build --config v2/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p grabadora/tsconfig.json",
    "test": "vitest run",
    "grabadora:build": "node grabadora/build.mjs",
    "grabadora": "node grabadora/build.mjs && node grabadora/dist/grabadora.mjs",
    "grabadora:paquete": "vite build && vite build --config v2/vite.config.ts && node grabadora/build.mjs && bash grabadora/empaquetar.sh"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@lezer/highlight": "^1.2.5",
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "codemirror": "^6.0.2",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "pyodide": "^0.29.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.9",
    "ws": "^8.18.0"
  }
}
